# Supabase Configuration for PocketTrack
# Copy this file to .env and fill in your values from the Supabase dashboard.
# (Supabase Dashboard -> Project Settings -> API)

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-publishable-key"

# IMPORTANT SECURITY GUIDELINES:
# - Use the anon (public) key ONLY.
# - NEVER expose or use the service_role key.

