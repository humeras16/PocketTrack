# Streamlit Secrets configuration for PocketTrack
# Copy this file to .streamlit/secrets.toml and fill in your values.
# (Supabase Dashboard -> Project Settings -> API)

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-publishable-key"

# Alternative nested syntax:
# [supabase]
# url = "https://your-project-id.supabase.co"
# key = "your-anon-publishable-key"

# IMPORTANT SECURITY GUIDELINES:
# - Use the anon (public) key ONLY.
# - NEVER expose or use the service_role key.

